# Required
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Protects the daily job (/api/cron/daily). Use a long random string.
CRON_SECRET=change-me
# Optional: email (newsletter confirmations, enquiry notifications, campaigns)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Humanity & Cooperation Initiative <no-reply@your-domain.example>"
